# Copia este archivo a .env y ajusta los valores. NUNCA commitees el .env real.
# Todos los valores tienen un default razonable en application.yaml; aqui puedes
# sobreescribir lo que necesites por entorno.

# =====================================================================
# Imagen / registro (los inyecta el pipeline; utiles en local)
# =====================================================================
GITHUB_REPOSITORY=tu-usuario/clinica_Backend
TAG=latest

# =====================================================================
# Base de datos MySQL (usada por los docker-compose)
# =====================================================================
MYSQL_DATABASE=medicitas
MYSQL_USER=medicitas
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-clave-root

# =====================================================================
# Conexion que lee la app (application.yaml)
# DESARROLLO LOCAL con hot-reload:
#   1) docker compose -f docker-compose.dev.yml up -d mysql   (solo la BD)
#   2) ./mvnw spring-boot:run                                  (app con devtools)
# Estos valores ya apuntan al MySQL del compose dev (puerto 3307).
# =====================================================================
DB_URL=jdbc:mysql://localhost:3307/medicitas
DB_USERNAME=medicitas
DB_PASSWORD=medicitas
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# =====================================================================
# JPA / Hibernate (opcional; defaults en application.yaml)
# =====================================================================
# JPA_DDL_AUTO=update          # en prod usa 'validate'
# JPA_SHOW_SQL=true
# JPA_FORMAT_SQL=true
# JPA_DIALECT=org.hibernate.dialect.MySQLDialect

# =====================================================================
# Servidor / Actuator (opcional)
# =====================================================================
# PORT=8080
# ACTUATOR_ENDPOINTS=health,info,metrics,prometheus
# ACTUATOR_HEALTH_DETAILS=always

# =====================================================================
# CORS: uno o varios origenes separados por coma
# =====================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Ejemplo multi-origen:
# CORS_ALLOWED_ORIGINS=https://app.midominio.com,https://admin.midominio.com,http://localhost:5173

# =====================================================================
# Perfil de Spring (default | staging | prod)
# =====================================================================
# SPRING_PROFILES_ACTIVE=default
